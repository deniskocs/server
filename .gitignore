# Python virtual environments (MCP servers, scripts, etc.)
.venv/

# Bytecode / cache
__pycache__/
*.py[cod]

# MCP local secrets (copy from config.example.yaml)
mcp/smb-files-mcp/config.yaml
mcp/smb-books-mcp/config.yaml

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*

# Local DB dumps under backups/ (keep *.sh)
backups/**/[0-9][0-9][0-9][0-9]-*/
